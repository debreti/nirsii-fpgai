set_global_assignment -name IP_TOOL_NAME "LPM_CONSTANT"
set_global_assignment -name IP_TOOL_VERSION "16.0"
set_global_assignment -name IP_GENERATED_DEVICE_FAMILY "{Cyclone V}"
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "CLK1_CONST.v"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "CLK1_CONST.bsf"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "CLK1_CONST_bb.v"]
